{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "MyOS: QEMU + GDB",
            "type": "gdb",
            "request": "attach",
            "executable": "${workspaceFolder}/build/kernel.elf",
            "target": "localhost:1234",
            "remote": true,
            "cwd": "${workspaceFolder}",
            "gdbpath": "/opt/homebrew/bin/x86_64-elf-gdb",
            "stopAtConnect": false,
            "valuesFormatting": "parseText",
            "preLaunchTask": "MyOS: Start debug VM",
            "postDebugTask": "MyOS: Stop debug VM"
        }
    ]
}
